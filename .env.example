# Copy this file to backend/.env and set values for your local environment.
PORT=4000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=library_management
DB_CONNECTION_LIMIT=10

# Fines are calculated per overdue day.
FINE_PER_DAY=2
MAX_BORROWED_BOOKS=5
RESERVATION_EXPIRY_DAYS=2

# Optional SMTP settings for password reset and email notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Library Management <no-reply@example.com>

# Set unique passwords of at least 12 characters for the local demo accounts.
# The setup script hashes these values before storing them.
SEED_ADMIN_EMAIL=admin@library.local
SEED_ADMIN_PASSWORD=
SEED_LIBRARIAN_EMAIL=librarian@library.local
SEED_LIBRARIAN_PASSWORD=
SEED_STUDENT_EMAIL=student@library.local
SEED_STUDENT_PASSWORD=
