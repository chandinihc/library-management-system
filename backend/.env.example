PORT=4000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
# Supabase Dashboard > Project Settings > Database > Connection string > Transaction pooler.
# Replace REGION with your project's region and URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_SSL=true
# Optional: download the Supabase database CA certificate and set its path relative to backend/.
DATABASE_SSL_CA_PATH=
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
FINE_PER_DAY=2
MAX_BORROWED_BOOKS=5
RESERVATION_EXPIRY_DAYS=2
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Library Management <no-reply@example.com>
SEED_ADMIN_EMAIL=admin@library.local
SEED_ADMIN_PASSWORD=
SEED_LIBRARIAN_EMAIL=librarian@library.local
SEED_LIBRARIAN_PASSWORD=
SEED_STUDENT_EMAIL=student@library.local
SEED_STUDENT_PASSWORD=
